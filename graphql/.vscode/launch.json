{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Uvicorn",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--lifespan", "on",
                "--host", "0.0.0.0",
                "--port", "8080"
            ],
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Load",
            "type": "debugpy",
            "request": "launch",
            "module": "tests.benchmark.load.runner",
            "args": [
                "--users", "100",
                "--spawn-rate", "10",
                "--run-time", "1m"
            ],
            "justMyCode": true,
            "console": "integratedTerminal",
            "preLaunchTask": "Run Uvicorn",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }            
        },
        {
            "name": "Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "tests/"
            ],
            "justMyCode": true,
            "console": "integratedTerminal",
            "preLaunchTask": "Run Uvicorn"
        }
    ]
}
